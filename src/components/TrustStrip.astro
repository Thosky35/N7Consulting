---
const items = ['Junior-Entreprise depuis 1977', 'Certifiée ISO 9001', 'Top 3 des Junior-Entreprises de France', '600+ projets réalisés'];
---

<div class="trust" role="list" aria-label="Nos repères">
	{items.map((t, i) => (
		<>
			{i > 0 && <svg class="sep" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1.5l2.6 8 8 2.5-8 2.5L12 22.5l-2.6-8-8-2.5 8-2.5Z" fill="currentColor" /></svg>}
			<span role="listitem">{t}</span>
		</>
	))}
</div>

<style>
	.trust { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px 22px; padding: 22px var(--gut); background: var(--paper); border-block: 1px solid var(--line); color: var(--navy); font-size: 13.5px; font-weight: 600; letter-spacing: .01em; text-align: center; }
	.sep { width: 12px; height: 12px; color: var(--gold); filter: drop-shadow(0 0 0 var(--navy)); }
</style>
