---
import { rich } from '../lib/rich';
import Deco from './Deco.astro';

interface Crumb {
	label: string;
	href?: string;
}
interface Props {
	crumbs: Crumb[];
	eyebrow: string;
	lead: string;
	em: string;
	text?: string;
	tall?: boolean;
	image?: string;
}
const { crumbs, eyebrow, lead, em, text, tall = false, image } = Astro.props;
---

<header class:list={['page-hero', { tall, 'has-img': !!image }]}>
	<span class="orb o1" aria-hidden="true"></span>
	<span class="orb o2" aria-hidden="true"></span>
	<span class="grid-bg" aria-hidden="true"></span>
	<Deco kind="gear" style="right:-80px;bottom:-110px;width:340px;color:#fff;opacity:.09" />
	<Deco kind="constellation" style="top:26px;right:22%;width:250px;color:#ffe680;opacity:.5" />
	<Deco kind="sine" style="left:var(--gut);bottom:26px;width:190px;color:#ffe680;opacity:.3" />
	{image && <div class="hero-photo" aria-hidden="true"><img src={image} alt="" loading="eager" /></div>}
	<div class="hero-inner">
		<nav class="crumbs" aria-label="Fil d’Ariane">
			{crumbs.map((c, i) => (
				<>
					{i > 0 && <span aria-hidden="true">/</span>}
					{c.href ? <a href={c.href}>{c.label}</a> : <span class:list={{ current: i === crumbs.length - 1 }}>{c.label}</span>}
				</>
			))}
		</nav>
		<p class="n7-eyebrow rise" style="--i:1">{eyebrow}</p>
		<h1 class="hl-title on-dark loaded rise" style="--i:2">{lead} <em>{em}</em></h1>
		{text && <p class="hero-text rise" style="--i:3" set:html={rich(text)} />}
		<div class="hero-actions rise" style="--i:4"><slot /></div>
	</div>
</header>

<style>
	.page-hero { position: relative; overflow: hidden; padding: 56px var(--gut) clamp(80px, 9vw, 120px); background: linear-gradient(130deg, var(--navy-d) 0%, #1b2590 62%, #3b4bff 130%); color: #fff; }
	.page-hero.tall { padding-bottom: clamp(120px, 12vw, 170px); }
	.page-hero::after { content: ''; position: absolute; inset: auto 0 0; height: 8px; background: var(--gold); }
	.orb { position: absolute; border-radius: 50%; pointer-events: none; filter: blur(2px); }
	.o1 { width: 620px; height: 620px; right: -180px; top: -260px; background: radial-gradient(circle at 35% 35%, rgba(59,75,255,.55), rgba(59,75,255,0) 66%); animation: drift 14s ease-in-out infinite alternate; }
	.o2 { width: 360px; height: 360px; right: 12%; bottom: -200px; background: radial-gradient(circle, rgba(255,212,59,.3), rgba(255,212,59,0) 68%); animation: drift 11s ease-in-out infinite alternate-reverse; }
	@keyframes drift { to { transform: translate3d(-40px, 30px, 0) scale(1.08); } }
	.grid-bg { position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(rgba(255,230,128,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255,230,128,.06) 1px, transparent 1px); background-size: 64px 64px; mask-image: linear-gradient(100deg, transparent 20%, #000 95%); -webkit-mask-image: linear-gradient(100deg, transparent 20%, #000 95%); }
	.hero-inner { position: relative; max-width: 960px; }
	.has-img .hero-inner { max-width: min(720px, 62%); }
	.hero-photo { position: absolute; z-index: 1; right: var(--gut); top: 50%; width: min(340px, 28vw); aspect-ratio: 4 / 5; transform: translateY(-50%); overflow: hidden; border-radius: 40% 40% var(--r-m) var(--r-m) / 28% 28% var(--r-m) var(--r-m); box-shadow: 10px 10px 0 var(--gold); background: var(--navy); }
	.hero-photo img { width: 100%; height: 100%; object-fit: cover; }
	.rise { animation: rise .6s ease-out both; animation-delay: calc(var(--i, 0) * 60ms + 60ms); }
	@keyframes rise { from { opacity: 0; transform: translate3d(0, 10px, 0); } to { opacity: 1; transform: none; } }
	.crumbs { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 48px; color: #a3aad6; font-size: 13.5px; animation: rise .5s ease-out both; }
	.crumbs a { color: inherit; text-decoration: none; transition: color .2s; }
	.crumbs a:hover { color: #fff; }
	.crumbs .current { color: var(--gold); }
	h1 { margin: 0; font-size: clamp(32.5px, 5.2vw, 80px); font-weight: 800; line-height: .98; letter-spacing: -.05em; text-wrap: balance; }
	.hero-text { max-width: 660px; margin: 28px 0 0; color: #d3d7f5; font-size: 17px; line-height: 1.7; }
	.hero-text :global(strong) { color: #fff; font-weight: 600; }
	.hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 28px 34px; margin-top: 40px; }
	.hero-actions:empty { display: none; }
	@media (max-width: 900px) {
		.hero-photo { display: none; }
		.has-img .hero-inner { max-width: 960px; }
	}
	@media (max-width: 600px) {
		.page-hero { padding: 34px var(--gut) 64px; }
		.page-hero.tall { padding-bottom: 100px; }
		.crumbs { margin-bottom: 32px; }
		.hero-text { font-size: 15.5px; }
	}
</style>
