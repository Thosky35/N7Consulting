---
import LinkCard from './LinkCard.astro';

interface Props {
	href: string;
	title: string;
	eyebrow?: string;
	image?: string;
}
const { href, title, eyebrow = 'Page suivante', image } = Astro.props;
---

<div class="next-wrap">
	<LinkCard href={href} title={title} kicker={eyebrow} image={image} />
</div>

<style>
	.next-wrap { padding: clamp(28px, 4vw, 52px) var(--gut); background: var(--paper); }
	.next-wrap :global(.link-card) { max-width: 920px; margin: 0 auto; }
</style>
